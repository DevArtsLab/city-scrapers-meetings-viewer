{
  "name": "meetings-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON docs-platform/engine/check.ts",
    "docs:drift:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON docs-platform/engine/check.ts --fail",
    "docs:drift:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test docs-platform/engine/check.test.ts",
    "docs:schema": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON docs-platform/engine/generate-schema.ts",
    "docs:schema:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON docs-platform/engine/generate-schema.ts --check",
    "docs:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON docs-platform/engine/check-links.ts",
    "docs:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON docs-platform/engine/sync-sources.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "^5.0.5",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "@mui/x-data-grid": "^9.6.0",
    "@mui/x-date-pickers": "^9.5.0",
    "@types/mdx": "^2.0.14",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.21",
    "fumadocs-core": "^16.15.1",
    "fumadocs-mdx": "^15.3.1",
    "fumadocs-ui": "^16.15.1",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
